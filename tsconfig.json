{
  "extends": "./tsconfig.base",
  "include": ["src", "website", "packages/app/__mocks__", "vitest.config.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    // Required for top-level await in `__mocks__/zustand.ts`, which is used for
    // unit tests. When transpiling and saving types, `tsconfig.base.json` is
    // used instead, which targets ES6.
    "module": "ES2022",
    "target": "ES2017",
    "outDir": "./dist"
  }
}
